# Groq — powers the text-based AI assistant (server-side only).
GROQ_API_KEY=

# Neon Postgres — authentication and chat history.
DATABASE_URL=

# Better Auth — generate a strong random secret.
BETTER_AUTH_SECRET=
# Full production URL, e.g. https://your-app.vercel.app
BETTER_AUTH_URL=

# Google OAuth sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional web-search provider. The app can fall back when this is unset.
TAVILY_API_KEY=
