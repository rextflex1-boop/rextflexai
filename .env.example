# Groq — the model that powers chat (app/api/chat/route.ts). Free tier: 30
# requests/min; llama-3.1-8b-instant specifically gets 14,400 requests/day.
# Get a key (no card needed): https://console.groq.com/keys
GROQ_API_KEY=
# Optional: override the model id. If you ever see "model does not exist or
# you do not have access to it", open https://console.groq.com/docs/models
# and paste the exact id your account shows there.
GROQ_MODEL_ID=llama-3.1-8b-instant

# Neon Postgres connection string (chats and login both use this).
# Get this from your Neon project → Connection Details.
DATABASE_URL=

# Auth (better-auth). Generate a random secret, e.g.:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
# Full URL of your deployment, e.g. https://rextflexai.vercel.app
# Optional locally — defaults to http://localhost:3000.
BETTER_AUTH_URL=

# Google sign-in (OAuth). Create these in Google Cloud Console → APIs &
# Services → Credentials → "OAuth client ID" (type: Web application).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# E2B (used by the buildProject tool in app/api/chat/route.ts + lib/sandbox.ts)
# to actually run/build/zip code in a real cloud sandbox, not just print it.
# Sign up + get a key: https://e2b.dev/dashboard?tab=keys
# Costs money per sandbox-second beyond the free tier — set a spending limit
# on the E2B dashboard.
E2B_API_KEY=
