# Groq — powers chat (app/api/chat/route.ts). Free tier for Silicon/Titan.
# Get a key (no card needed): https://console.groq.com/keys
GROQ_API_KEY=

# Neon Postgres connection string (chats and login both use this).
# Get this from your Neon project → Connection Details.
DATABASE_URL=

# Auth (better-auth). Generate a random secret, e.g.:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
# Full URL of your deployment, e.g. https://rextflexai.up.railway.app
BETTER_AUTH_URL=

# Google sign-in (OAuth). Create these in Google Cloud Console → APIs &
# Services → Credentials → "OAuth client ID" (type: Web application).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# E2B (used by the writeFile/finishBuild tools in app/api/chat/route.ts +
# lib/sandbox.ts) to actually run/build/zip code in a real cloud sandbox.
# Sign up + get a key: https://e2b.dev/dashboard?tab=keys
# Costs money per sandbox-second beyond the free tier — set a spending limit
# on the E2B dashboard.
E2B_API_KEY=

# Tavily (lib/web-search.ts) — the webSearch tool's primary search provider.
# Free tier available, no card needed: https://app.tavily.com
# If unset, falls back to a best-effort DuckDuckGo scrape (less reliable).
TAVILY_API_KEY=

# GitHub push (lib/github.ts) — lets the AI commit files directly to a repo
# when explicitly asked (the pushToGithub tool). All three are required for
# that tool to work; leave blank to disable it.
# Create a token at https://github.com/settings/tokens — scope it to just
# this one repo, with Contents: Read and write.
GITHUB_TOKEN=
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
# Optional — defaults to "main"
GITHUB_REPO_BRANCH=

# ImgBB image storage (Feature 2: photo/image uploads)
# Get your API key from https://api.imgbb.com/
# Keep this server-side; do not expose it in NEXT_PUBLIC_* variables.
IMGBB_API_KEY=

# S3-compatible object storage is still used for generated downloadable files
# such as ZIPs created by the AI build tools.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=rextflexai
S3_REGION=us-east-1
# Optional public/custom-domain base URL. Leave blank to use signed URLs.
S3_PUBLIC_URL=
